# Copie este arquivo para .streamlit/secrets.toml e preencha com os dados reais.
# NUNCA suba o secrets.toml real pro GitHub — só o .example fica versionado.

DATABASE_URL = "postgresql://postgres:[SUA-SENHA]@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# Usuários do login do app. Gere o hash de cada senha rodando
# `python gerar_hash_senha.py` localmente e cole o resultado aqui.
[auth_users]
clarice = "$2b$12$SUBSTITUA_PELO_HASH_GERADO"
